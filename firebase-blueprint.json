{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with email and role",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["student", "staff", "admin"] },
        "photoURL": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["name", "email", "role"]
    },
    "FoodItem": {
      "title": "Food Item",
      "description": "Menu item available in SVCE cafe",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "price": { "type": "number" },
        "prepTimeMinutes": { "type": "number" },
        "isAvailable": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 250 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "isVeg": { "type": "boolean" },
        "rating": { "type": "number" }
      },
      "required": ["name", "category", "price", "isAvailable"]
    },
    "Category": {
      "title": "Category",
      "description": "Food category definition",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 50 },
        "order": { "type": "number" },
        "icon": { "type": "string" }
      },
      "required": ["name"]
    },
    "Order": {
      "title": "Order",
      "description": "Food order with token and live status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string", "maxLength": 30 },
        "tokenNumber": { "type": "number" },
        "tokenString": { "type": "string", "maxLength": 10 },
        "dateKey": { "type": "string", "maxLength": 12 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userEmail": { "type": "string", "maxLength": 120 },
        "status": {
          "type": "string",
          "enum": ["PLACED", "ACCEPTED", "PREPARING", "READY", "COMPLETED", "CANCELLED"]
        },
        "paymentMethod": { "type": "string", "enum": ["COUNTER", "UPI", "ONLINE"] },
        "paymentStatus": { "type": "string", "enum": ["PENDING", "PAID"] },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "couponCode": { "type": "string" },
        "createdAt": { "type": "string" },
        "acceptedAt": { "type": "string" },
        "preparingAt": { "type": "string" },
        "readyAt": { "type": "string" },
        "completedAt": { "type": "string" },
        "estimatedWaitMin": { "type": "number" }
      },
      "required": ["orderNumber", "tokenNumber", "tokenString", "userId", "status", "total"]
    },
    "QueueState": {
      "title": "Daily Queue State",
      "description": "Tracks daily token sequences and currently serving tokens",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dateKey": { "type": "string", "maxLength": 12 },
        "lastToken": { "type": "number" },
        "currentServingToken": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["dateKey", "lastToken", "currentServingToken"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Live student notification for token and status updates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "maxLength": 128 },
        "orderId": { "type": "string", "maxLength": 128 },
        "tokenString": { "type": "string", "maxLength": 10 },
        "title": { "type": "string", "maxLength": 100 },
        "message": { "type": "string", "maxLength": 250 },
        "type": { "type": "string", "enum": ["STATUS_UPDATE", "READY_ALERT", "QUEUE_ALERT", "INFO"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "message", "type", "read"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "Student bookmarked food items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "maxLength": 128 },
        "foodId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "foodId"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discount codes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string", "maxLength": 20 },
        "discountPercentage": { "type": "number" },
        "discountAmount": { "type": "number" },
        "minOrderValue": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["code", "isActive"]
    },
    "Setting": {
      "title": "Canteen Settings",
      "description": "Operational settings for SVCE Cafe",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "isOpen": { "type": "boolean" },
        "announcement": { "type": "string", "maxLength": 200 },
        "prepDelayOffset": { "type": "number" },
        "closingNotice": { "type": "string", "maxLength": 100 }
      },
      "required": ["isOpen"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Student, staff and admin profiles"
    },
    "/foods/{foodId}": {
      "schema": { "$ref": "#/entities/FoodItem" },
      "description": "Food menu items"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Food categories"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer food orders with tokens"
    },
    "/queue/{dateKey}": {
      "schema": { "$ref": "#/entities/QueueState" },
      "description": "Daily queue tracker"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User notifications"
    },
    "/favorites/{favoriteId}": {
      "schema": { "$ref": "#/entities/Favorite" },
      "description": "User favorite food items"
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Promotional coupons"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/Setting" },
      "description": "Canteen operational parameters"
    }
  }
}
