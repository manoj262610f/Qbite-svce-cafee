rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)))
        ? getUserData().role
        : 'student';
    }

    function isActiveUser() {
      return isSignedIn() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        getUserData().accountStatus != 'SUSPENDED'
      );
    }

    function isAdminEmail() {
      return isSignedIn() && request.auth.token.email.lower() == 'the.team.alpha.ece2026@gmail.com';
    }

    function isStaffEmail() {
      return isSignedIn() && request.auth.token.email.lower() == 'manojreddy8283@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && isActiveUser() && (getUserRole() == 'admin' || isAdminEmail());
    }

    function isStaff() {
      return isSignedIn() && isActiveUser() && (getUserRole() == 'staff' || getUserRole() == 'admin' || isStaffEmail() || isAdminEmail());
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      // On creation, normal users can register as student with ACTIVE status; designated admin/staff allowed their respective initial roles
      allow create: if isOwner(userId) && (
        !('role' in request.resource.data) ||
        request.resource.data.role == 'student' ||
        (request.resource.data.role == 'admin' && isAdminEmail()) ||
        (request.resource.data.role == 'staff' && (isStaffEmail() || isAdminEmail()))
      ) && (
        !('accountStatus' in request.resource.data) || request.resource.data.accountStatus == 'ACTIVE'
      );
      // Admin can update any user's role or status; user can update only safe personal profile fields or normalize to student
      allow update: if isAdmin() || (
        isOwner(userId) &&
        (
          request.resource.data.role == resource.data.role ||
          request.resource.data.role == 'student' ||
          (request.resource.data.role == 'admin' && isAdminEmail()) ||
          (request.resource.data.role == 'staff' && (isStaffEmail() || isAdminEmail()))
        ) &&
        request.resource.data.accountStatus == resource.data.accountStatus
      );
      allow delete: if isAdmin();
    }

    // 2. Foods catalog (Read-only for public/students, write for admin)
    match /foods/{foodId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Orders collection
    match /orders/{orderId} {
      // Read allowed if order owner, staff/admin, or if order is READY (for public display pickup screen)
      allow read: if isStaff() ||
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        (resource.data.status == 'READY');

      // Create: Authenticated student creating order with their own uid in PLACED and PENDING state
      allow create: if isSignedIn() && isActiveUser() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'PLACED' &&
        request.resource.data.paymentStatus == 'PENDING';

      // Update: Staff can process transitions; Student can only cancel their own PLACED order
      allow update: if isStaff() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'PLACED' &&
        request.resource.data.status == 'CANCELLED'
      );

      allow delete: if isAdmin();
    }

    // 4. Daily Queue collection
    match /queue/{dateKey} {
      allow read: if true;
      allow write: if isSignedIn() && isActiveUser();
    }

    // 5. In-app notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 6. Favorites
    match /favorites/{favoriteId} {
      allow read, write: if isSignedIn() && favoriteId.matches(request.auth.uid + '.*');
    }

    // 7. Canteen Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isStaff();
    }
  }
}
