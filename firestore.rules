rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)))
        ? getUserData().get('role', 'student')
        : 'student';
    }

    function isAdminEmail() {
      return isSignedIn() && (
        request.auth.token.email in ['the.team.alpha.ece2026@gmail.com', 'manojreddy8022@gmail.com']
      );
    }

    function isStaffEmail() {
      return isSignedIn() && (
        request.auth.token.email in ['manojreddy8283@gmail.com', 'manojreddy8022@gmail.com', 'the.team.alpha.ece2026@gmail.com']
      );
    }

    function isAdmin() {
      return isSignedIn() && (getUserRole() == 'admin' || isAdminEmail());
    }

    function isStaff() {
      return isSignedIn() && (getUserRole() == 'staff' || getUserRole() == 'admin' || isStaffEmail() || isAdminEmail());
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      // On creation, normal users can register as student; designated admin/staff allowed their respective initial roles
      allow create: if isOwner(userId) && (
        !('role' in request.resource.data) ||
        request.resource.data.role == 'student' ||
        (request.resource.data.role == 'admin' && isAdminEmail()) ||
        (request.resource.data.role == 'staff' && (isStaffEmail() || isAdminEmail()))
      );
      // Admin can update any user; owner can update their own profile without elevating their role
      allow update: if isAdmin() || (
        isOwner(userId) && (
          !('role' in request.resource.data) ||
          request.resource.data.role == resource.data.get('role', 'student')
        )
      );
      allow delete: if isAdmin();
    }

    // 2. Foods catalog (Read-only for all, write for staff/admin)
    match /foods/{foodId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 3. Orders collection
    match /orders/{orderId} {
      // Students can read their own orders; staff/admin can read all orders;
      // Also allow read for active orders on the pickup display board
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isStaff() ||
        resource.data.status in ['READY', 'PREPARING', 'ACCEPTED']
      );

      // Student can create orders where userId == request.auth.uid
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;

      // Staff can update order status and operational fields;
      // Student can only cancel their own order while it is still PLACED / pending
      allow update: if (isStaff() && request.resource.data.userId == resource.data.userId) || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        (resource.data.status == 'PLACED' || resource.data.get('orderStatus', '') == 'pending') &&
        (request.resource.data.status == 'CANCELLED' || request.resource.data.get('orderStatus', '') == 'cancelled')
      );

      allow delete: if isAdmin();
    }

    // 4. Daily Queue collection
    match /queue/{dateKey} {
      allow read, write: if isSignedIn();
    }

    // 5. In-app notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 6. Favorites
    match /favorites/{favoriteId} {
      allow read, write: if isSignedIn() && favoriteId.matches(request.auth.uid + '.*');
    }

    // 7. Canteen Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isStaff();
    }
  }
}
